<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:inf="clr-namespace:SempaPumpStation.Infrastructure">

    <!-- ============================================================= -->
    <!--  SEMPA Pump Test Bench — modern dark industrial HMI theme     -->
    <!-- ============================================================= -->

    <!-- Shared converters (app-wide) -->
    <inf:TagFormatConverter x:Key="Fmt"/>
    <inf:BoolTextConverter x:Key="BoolText"/>
    <inf:BoolVisibilityConverter x:Key="BoolVis"/>
    <inf:SeverityBrushConverter x:Key="Sev"/>

    <!-- Surfaces -->
    <Color x:Key="C.App">#0E141B</Color>
    <Color x:Key="C.Rail">#121A23</Color>
    <Color x:Key="C.Header">#0B1116</Color>
    <Color x:Key="C.Card">#18222E</Color>
    <Color x:Key="C.Card2">#1E2A38</Color>
    <Color x:Key="C.CardHi">#233343</Color>
    <Color x:Key="C.Border">#2A3A4A</Color>
    <Color x:Key="C.BorderHi">#38506A</Color>
    <Color x:Key="C.Field">#0F171F</Color>

    <!-- Text -->
    <Color x:Key="C.Text">#E7EEF5</Color>
    <Color x:Key="C.TextDim">#8A9CAD</Color>
    <Color x:Key="C.TextFaint">#5E7183</Color>

    <!-- Accents / status -->
    <Color x:Key="C.Accent">#22C1D6</Color>
    <Color x:Key="C.Accent2">#3B82F6</Color>
    <Color x:Key="C.Run">#2ECC71</Color>
    <Color x:Key="C.Warn">#F5A623</Color>
    <Color x:Key="C.Alarm">#E74C3C</Color>
    <Color x:Key="C.Idle">#5A6B7B</Color>

    <SolidColorBrush x:Key="B.App"     Color="{StaticResource C.App}"/>
    <SolidColorBrush x:Key="B.Rail"    Color="{StaticResource C.Rail}"/>
    <SolidColorBrush x:Key="B.Header"  Color="{StaticResource C.Header}"/>
    <SolidColorBrush x:Key="B.Card"    Color="{StaticResource C.Card}"/>
    <SolidColorBrush x:Key="B.Card2"   Color="{StaticResource C.Card2}"/>
    <SolidColorBrush x:Key="B.CardHi"  Color="{StaticResource C.CardHi}"/>
    <SolidColorBrush x:Key="B.Border"  Color="{StaticResource C.Border}"/>
    <SolidColorBrush x:Key="B.BorderHi" Color="{StaticResource C.BorderHi}"/>
    <SolidColorBrush x:Key="B.Field"   Color="{StaticResource C.Field}"/>
    <SolidColorBrush x:Key="B.Text"    Color="{StaticResource C.Text}"/>
    <SolidColorBrush x:Key="B.TextDim" Color="{StaticResource C.TextDim}"/>
    <SolidColorBrush x:Key="B.TextFaint" Color="{StaticResource C.TextFaint}"/>
    <SolidColorBrush x:Key="B.Accent"  Color="{StaticResource C.Accent}"/>
    <SolidColorBrush x:Key="B.Accent2" Color="{StaticResource C.Accent2}"/>
    <SolidColorBrush x:Key="B.Run"     Color="{StaticResource C.Run}"/>
    <SolidColorBrush x:Key="B.Warn"    Color="{StaticResource C.Warn}"/>
    <SolidColorBrush x:Key="B.Alarm"   Color="{StaticResource C.Alarm}"/>
    <SolidColorBrush x:Key="B.Idle"    Color="{StaticResource C.Idle}"/>

    <!-- TerakkiUI user views and modal windows (UserTheme) in this palette -->
    <SolidColorBrush x:Key="TerakkiUser.Backdrop"    Color="#B0060A0E"/>
    <SolidColorBrush x:Key="TerakkiUser.Card"        Color="{StaticResource C.Card}"/>
    <SolidColorBrush x:Key="TerakkiUser.CardBorder"  Color="{StaticResource C.BorderHi}"/>
    <SolidColorBrush x:Key="TerakkiUser.Field"       Color="{StaticResource C.Field}"/>
    <SolidColorBrush x:Key="TerakkiUser.FieldBorder" Color="{StaticResource C.Border}"/>
    <SolidColorBrush x:Key="TerakkiUser.Header"      Color="{StaticResource C.Card2}"/>
    <SolidColorBrush x:Key="TerakkiUser.RowAlt"      Color="#121C25"/>
    <SolidColorBrush x:Key="TerakkiUser.Text"        Color="{StaticResource C.Text}"/>
    <SolidColorBrush x:Key="TerakkiUser.TextDim"     Color="{StaticResource C.TextDim}"/>
    <SolidColorBrush x:Key="TerakkiUser.Accent"      Color="{StaticResource C.Accent}"/>
    <SolidColorBrush x:Key="TerakkiUser.AccentText"  Color="#04222A"/>
    <SolidColorBrush x:Key="TerakkiUser.Success"     Color="{StaticResource C.Run}"/>
    <SolidColorBrush x:Key="TerakkiUser.Warn"        Color="{StaticResource C.Warn}"/>
    <SolidColorBrush x:Key="TerakkiUser.Error"       Color="{StaticResource C.Alarm}"/>

    <FontFamily x:Key="F.Ui">Segoe UI</FontFamily>
    <sys:Double x:Key="S.Radius">8</sys:Double>

    <!-- ============================ Text styles ============================ -->
    <Style x:Key="T.Base" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <Style x:Key="T.H1" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="T.H2" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="T.Section" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource B.Accent}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="T.Label" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="T.Value" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ============================ Card ============================ -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource B.Card}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <Style x:Key="CardTight" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="12"/>
    </Style>

    <!-- ============================ Buttons ============================ -->
    <Style x:Key="Btn" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="Background" Value="{StaticResource B.Card2}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource B.CardHi}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.BorderHi}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="{StaticResource B.Accent}"/>
        <Setter Property="Foreground" Value="#04222A"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Accent}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn.Success" TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
        <Setter Property="Background" Value="{StaticResource B.Run}"/>
        <Setter Property="Foreground" Value="#062012"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Run}"/>
    </Style>
    <Style x:Key="Btn.Danger" TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
        <Setter Property="Background" Value="{StaticResource B.Alarm}"/>
        <Setter Property="Foreground" Value="#2A0906"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Alarm}"/>
    </Style>
    <Style x:Key="Btn.Warn" TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
        <Setter Property="Background" Value="{StaticResource B.Warn}"/>
        <Setter Property="Foreground" Value="#2A1B02"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Warn}"/>
    </Style>

    <!-- Navigation rail button (checkable look via Tag=active) -->
    <Style x:Key="NavBtn" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="14,0,10,0"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Margin="8,1">
                        <Grid>
                            <Border x:Name="bar" Width="3" HorizontalAlignment="Left" CornerRadius="2"
                                    Background="{StaticResource B.Accent}" Margin="2,8" Visibility="Collapsed"/>
                            <ContentPresenter VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource B.Card}"/>
                            <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="active">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource B.Card2}"/>
                            <Setter TargetName="bar" Property="Visibility" Value="Visible"/>
                            <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon / header button -->
    <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}"/>
    </Style>

    <!-- ============================ TextBox ============================ -->
    <Style x:Key="Tb" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="CaretBrush" Value="{StaticResource B.Accent}"/>
        <Setter Property="Background" Value="{StaticResource B.Field}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="9,7"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- PasswordBox in the Tb look (applied implicitly inside the login dialogs) -->
    <Style x:Key="Pb" TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="CaretBrush" Value="{StaticResource B.Accent}"/>
        <Setter Property="Background" Value="{StaticResource B.Field}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="9,7"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Accent}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ ComboBox (light styling) ============================ -->
    <Style x:Key="Cb" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="Background" Value="{StaticResource B.Field}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="8,0"/>
    </Style>

    <!-- ============================ ListBox ============================ -->
    <Style x:Key="Lb" TargetType="ListBox">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="Background" Value="{StaticResource B.Field}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>
    <Style x:Key="LbItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="5" Margin="3,1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource B.Card2}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource B.Accent}"/>
                            <Setter Property="Foreground" Value="#04222A"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================ Choice tile ============================ -->
    <!-- A selectable option (power source, flowmeter, transmitter). Tag: "active" = selected,
         "held" = taken by another zone. Disabled while the PLC has the selection locked. -->
    <Style x:Key="Choice" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="Background" Value="{StaticResource B.Field}"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="10,7"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.BorderHi}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="held">
                            <Setter TargetName="bd" Property="Background" Value="#2A2220"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#5A3A2A"/>
                            <Setter Property="Foreground" Value="{StaticResource B.TextDim}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="active">
                            <Setter TargetName="bd" Property="Background" Value="#123A44"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Accent}"/>
                            <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Status pill -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="11,4"/>
        <Setter Property="Background" Value="{StaticResource B.Card2}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ============================ DataGrid (dark) ============================ -->
    <Style x:Key="Dg" TargetType="DataGrid">
        <Setter Property="FontFamily" Value="{StaticResource F.Ui}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        <Setter Property="Background" Value="{StaticResource B.Field}"/>
        <Setter Property="RowBackground" Value="{StaticResource B.Field}"/>
        <Setter Property="AlternatingRowBackground" Value="#121C25"/>
        <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource B.Border}"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserDeleteRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="RowHeight" Value="28"/>
        <Setter Property="EnableRowVirtualization" Value="True"/>
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource B.Card2}"/>
                    <Setter Property="Foreground" Value="{StaticResource B.TextDim}"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="6,0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#123A44"/>
                            <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Default the app's plain controls -->
    <Style TargetType="TextBlock" BasedOn="{StaticResource T.Base}"/>
    <Style TargetType="TextBox" BasedOn="{StaticResource Tb}"/>
    <Style TargetType="Button" BasedOn="{StaticResource Btn}"/>
    <Style TargetType="ComboBox" BasedOn="{StaticResource Cb}"/>

</ResourceDictionary>
