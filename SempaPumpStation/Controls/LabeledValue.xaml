<UserControl x:Class="SempaPumpStation.Controls.LabeledValue"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="root">
    <StackPanel Margin="0,0,0,10">
        <TextBlock Text="{Binding Label, ElementName=root}" Style="{StaticResource T.Label}"
                   FontSize="10.5" Margin="0,0,0,3"/>
        <Border Background="{StaticResource B.Field}" BorderBrush="{StaticResource B.Border}" BorderThickness="1"
                CornerRadius="6" Padding="9,7" MinHeight="34">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Value, ElementName=root}" Style="{StaticResource T.Value}"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Unit, ElementName=root}" Style="{StaticResource T.Value}"
                           Foreground="{StaticResource B.TextDim}" Margin="5,0,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
