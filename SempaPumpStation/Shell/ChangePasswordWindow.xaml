<u:ModalOverlayWindow x:Class="SempaPumpStation.Shell.ChangePasswordWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:u="clr-namespace:TerakkiUI.Components.User;assembly=TerakkiUI"
                Title="Şifre" FontFamily="{StaticResource F.Ui}">
    <Window.Resources>
        <Style TargetType="PasswordBox" BasedOn="{StaticResource Pb}"/>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Enter" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>

    <!-- TerakkiUI ChangePasswordViewModel -->
    <Border Style="{StaticResource Card}" Padding="24" Width="400" BorderBrush="{StaticResource B.BorderHi}"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
            <TextBlock Text="{Binding Heading}" Style="{StaticResource T.H2}"/>
            <TextBlock Text="{Binding Message}" Style="{StaticResource T.Label}" TextWrapping="Wrap" Margin="0,4,0,18"/>

            <TextBlock Text="Mevcut şifre" Style="{StaticResource T.Label}" FontSize="10.5" Margin="0,0,0,3"/>
            <u:BindablePasswordBox x:Name="CurrentBox" Password="{Binding CurrentPassword, Mode=TwoWay}" Height="34" Margin="0,0,0,12"/>

            <TextBlock Text="Yeni şifre" Style="{StaticResource T.Label}" FontSize="10.5" Margin="0,0,0,3"/>
            <u:BindablePasswordBox Password="{Binding NewPassword, Mode=TwoWay}" Height="34" Margin="0,0,0,12"/>

            <TextBlock Text="Yeni şifre (tekrar)" Style="{StaticResource T.Label}" FontSize="10.5" Margin="0,0,0,3"/>
            <u:BindablePasswordBox Password="{Binding ConfirmPassword, Mode=TwoWay}" Height="34"/>

            <TextBlock Text="{Binding Error}" Foreground="{StaticResource B.Alarm}" TextWrapping="Wrap" FontSize="12.5" Margin="0,10,0,0"/>

            <UniformGrid Columns="2" Margin="0,16,0,0">
                <Button Content="{Binding CancelText}" Style="{StaticResource Btn}" Command="{Binding CancelCommand}" Margin="0,0,6,0"/>
                <Button Content="Kaydet" Style="{StaticResource Btn.Primary}" Command="{Binding SaveCommand}" Margin="6,0,0,0"/>
            </UniformGrid>
        </StackPanel>
    </Border>
</u:ModalOverlayWindow>
