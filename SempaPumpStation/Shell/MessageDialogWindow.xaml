<u:ModalOverlayWindow x:Class="SempaPumpStation.Shell.MessageDialogWindow"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:u="clr-namespace:TerakkiUI.Components.User;assembly=TerakkiUI"
                Title="Mesaj" FontFamily="{StaticResource F.Ui}">
    <!-- TerakkiUI ConfigurableDialogViewModel, for the HMI's IDialogService -->
    <Border Style="{StaticResource Card}" Padding="24" MinWidth="380" MaxWidth="560" BorderBrush="{StaticResource B.BorderHi}"
            HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource T.H2}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Visibility="{Binding HasTitle, Converter={StaticResource BoolVis}}"/>
            <TextBlock Text="{Binding Content}" Foreground="{StaticResource B.Text}" FontSize="14" TextWrapping="Wrap"/>
            <ItemsControl ItemsSource="{Binding Buttons}" HorizontalAlignment="Right" Margin="0,20,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Text}" Command="{Binding Command}" Style="{StaticResource Btn}" MinWidth="100" Margin="8,0,0,0"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</u:ModalOverlayWindow>
