<Window x:Class="SempaPumpStation.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:inf="clr-namespace:SempaPumpStation.Infrastructure"
        xmlns:s="clr-namespace:SempaPumpStation.Screens"
        Title="SEMPA — Pompa Test Standı" Height="1000" Width="1600"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        WindowStyle="None" Background="{StaticResource B.App}"
        FontFamily="{StaticResource F.Ui}" TextOptions.TextFormattingMode="Ideal">

    <WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="54" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <inf:TagFormatConverter x:Key="Fmt"/>
        <inf:SeverityBrushConverter x:Key="Sev"/>
        <inf:BoolTextConverter x:Key="BoolText"/>
        <inf:BoolVisibilityConverter x:Key="BoolVis"/>
        <inf:BoolBrushConverter x:Key="CommBrush" OnBrush="{StaticResource B.Run}" OffBrush="{StaticResource B.Alarm}"/>

        <!-- Screen VM → View map -->
        <DataTemplate DataType="{x:Type s:OverviewViewModel}"><s:OverviewView/></DataTemplate>
        <DataTemplate DataType="{x:Type s:ZoneViewModel}"><s:ZoneView/></DataTemplate>
        <DataTemplate DataType="{x:Type s:InstrumentsViewModel}"><s:InstrumentsView/></DataTemplate>
        <DataTemplate DataType="{x:Type s:ReportViewModel}"><s:ReportView/></DataTemplate>
        <DataTemplate DataType="{x:Type s:FirmaRecipeViewModel}"><s:RecipeEditorView/></DataTemplate>
        <DataTemplate DataType="{x:Type s:PompaRecipeViewModel}"><s:RecipeEditorView/></DataTemplate>
        <DataTemplate DataType="{x:Type s:MotorRecipeViewModel}"><s:RecipeEditorView/></DataTemplate>
        <DataTemplate DataType="{x:Type s:HatRecipeViewModel}"><s:RecipeEditorView/></DataTemplate>
        <DataTemplate DataType="{x:Type s:TestiYapanRecipeViewModel}"><s:RecipeEditorView/></DataTemplate>
        <DataTemplate DataType="{x:Type s:AlarmsViewModel}"><s:AlarmsView/></DataTemplate>
        <DataTemplate DataType="{x:Type s:EventsViewModel}"><s:EventsView/></DataTemplate>
        <DataTemplate DataType="{x:Type s:TrendViewModel}"><s:TrendView/></DataTemplate>
        <DataTemplate DataType="{x:Type s:UserLogViewModel}"><s:UserLogView/></DataTemplate>

        <!-- Nav rail section header -->
        <Style x:Key="NavHeader" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource B.TextFaint}"/>
            <Setter Property="Margin" Value="18,16,0,6"/>
        </Style>

        <!-- Nav item -->
        <DataTemplate x:Key="NavItemTemplate">
            <Button Style="{StaticResource NavBtn}" Tag="{Binding TagState}"
                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Icon}" FontSize="15" Width="24" Foreground="{StaticResource B.Accent}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ Header ============ -->
        <Border Grid.Row="0" Background="{StaticResource B.Header}" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
                    <Border Background="{StaticResource B.Accent}" CornerRadius="6" Width="30" Height="30" Margin="0,0,10,0">
                        <TextBlock Text="S" FontSize="17" FontWeight="Bold" Foreground="#04222A"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SEMPA" FontSize="14" FontWeight="Bold" Foreground="{StaticResource B.Text}"/>
                        <TextBlock Text="Pompa Test İstasyonu" FontSize="10.5" Foreground="{StaticResource B.TextDim}"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource T.H2}"
                           VerticalAlignment="Center" Margin="8,0"/>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border Style="{StaticResource Pill}" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="9" Height="9" Margin="0,0,7,0" VerticalAlignment="Center"
                                     Fill="{Binding Context.Tags[PLC_COMM_OK].TagValue, Converter={StaticResource CommBrush}}"/>
                            <TextBlock Text="{Binding Context.BackendText}" FontSize="12" Foreground="{StaticResource B.TextDim}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding Context.Tags[TARIH_SAAT].TagValue}" Style="{StaticResource T.Value}"
                               Foreground="{StaticResource B.TextDim}" Margin="10,0" FontSize="13"/>
                    <Border Width="1" Background="{StaticResource B.Border}" Margin="6,12"/>
                    <TextBlock Text="{Binding UserName}" Style="{StaticResource T.Value}" Margin="10,0"/>
                    <Button Content="Giriş" Style="{StaticResource IconBtn}" Command="{Binding LoginCommand}"/>
                    <Button Content="Alarm Reset" Style="{StaticResource IconBtn}" Command="{Binding AlarmResetCommand}"/>
                    <Border Width="1" Background="{StaticResource B.Border}" Margin="6,12"/>
                    <Button x:Name="BtnMin" Content="—" Style="{StaticResource IconBtn}" Click="Min_Click" FontSize="15"/>
                    <Button x:Name="BtnMax" Content="▢" Style="{StaticResource IconBtn}" Click="Max_Click" FontSize="13"/>
                    <Button x:Name="BtnClose" Content="✕" Style="{StaticResource IconBtn}" Click="Close_Click" FontSize="14"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Body ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Rail -->
            <Border Grid.Column="0" Background="{StaticResource B.Rail}" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Padding="12" BorderBrush="{StaticResource B.Border}" BorderThickness="0,1,0,0">
                        <Button Content="Uygulamadan Çık" Style="{StaticResource Btn}" Click="Close_Click"/>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="İZLEME &amp; KONTROL" Style="{StaticResource NavHeader}"/>
                            <ItemsControl ItemsSource="{Binding MainNav}" ItemTemplate="{StaticResource NavItemTemplate}"/>
                            <TextBlock Text="REÇETELER" Style="{StaticResource NavHeader}"/>
                            <ItemsControl ItemsSource="{Binding RecipeNav}" ItemTemplate="{StaticResource NavItemTemplate}"/>
                            <TextBlock Text="TANI" Style="{StaticResource NavHeader}"/>
                            <ItemsControl ItemsSource="{Binding DiagNav}" ItemTemplate="{StaticResource NavItemTemplate}"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Alarm status strip -->
                <Border Grid.Row="0" Background="{StaticResource B.Header}" Padding="18,9"
                        BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Ellipse Width="11" Height="11" VerticalAlignment="Center"
                                 Fill="{Binding Alarms.BannerSeverity, Converter={StaticResource Sev}}"/>
                        <Border DockPanel.Dock="Right" Background="{StaticResource B.Card2}" CornerRadius="10" Padding="10,2"
                                Visibility="{Binding Alarms.HasAlarm, Converter={StaticResource BoolVis}}">
                            <TextBlock VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource B.Alarm}">
                                <Run Text="{Binding Alarms.ActiveCount, Mode=OneWay}"/><Run Text=" aktif alarm"/>
                            </TextBlock>
                        </Border>
                        <TextBlock Text="{Binding Alarms.Banner}" Margin="12,0,0,0" VerticalAlignment="Center"
                                   FontSize="12.5" Foreground="{StaticResource B.Text}"/>
                    </DockPanel>
                </Border>

                <ContentControl Grid.Row="1" Content="{Binding Current}" Margin="0"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
