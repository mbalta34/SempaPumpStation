<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{4F905585-4734-4FC4-B6B2-BD009A066AA5}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>SempaPumpStation</RootNamespace>
    <AssemblyName>SempaPumpStation</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <ProjectTypeGuids>{60dc8134-eba5-43b8-bcc9-bb4bc16c2548};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <WarningLevel>4</WarningLevel>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Core" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Xaml">
      <RequiredTargetFramework>4.0</RequiredTargetFramework>
    </Reference>
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <!-- The S7 connection logs through Serilog (same package as TerakkiFramework) -->
    <Reference Include="Serilog, Version=4.1.0.0, Culture=neutral, PublicKeyToken=24c2f752a8e58a10, processorArchitecture=MSIL">
      <HintPath>..\Terakki\packages\Serilog.4.1.0\lib\net471\Serilog.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Application entry point -->
  <ItemGroup>
    <ApplicationDefinition Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </ApplicationDefinition>
  </ItemGroup>

  <!-- All XAML (views, controls, windows, resource dictionaries) except App.xaml -->
  <ItemGroup>
    <Page Include="**\*.xaml" Exclude="App.xaml;obj\**\*.xaml;bin\**\*.xaml">
      <Generator>MSBuild:Compile</Generator>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

  <!-- All C# sources -->
  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="obj\**\*.cs;bin\**\*.cs;**\*.xaml.cs" />
    <!-- Code-behind nests under its XAML file in Solution Explorer (Foo.xaml.cs -> Foo.xaml) -->
    <Compile Include="**\*.xaml.cs" Exclude="obj\**\*.cs;bin\**\*.cs">
      <DependentUpon>%(Filename)</DependentUpon>
    </Compile>
  </ItemGroup>

  <!-- Properties resources -->
  <ItemGroup>
    <EmbeddedResource Include="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <None Include="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <None Include="App.config" />
    <None Include="config.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="PlcInterface\Generate-PlcInterface.ps1" />
    <None Include="PlcInterface\Sources\**\*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Terakki\TerakkiFramework\TerakkiFramework.csproj">
      <Project>{503e5b29-b2dc-462e-b88d-0b4d1a83b7df}</Project>
      <Name>TerakkiFramework</Name>
    </ProjectReference>
    <ProjectReference Include="..\Terakki\TerakkiUI\TerakkiUI.csproj">
      <Name>TerakkiUI</Name>
    </ProjectReference>
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

  <!-- The referenced framework's transitive NuGet DLLs (Serilog, Microsoft.Extensions.*,
       System.Diagnostics.DiagnosticSource, Sharp7, ...) live in its output but don't flow
       through the ProjectReference automatically, so copy them into our output. -->
  <Target Name="CopyTerakkiDependencies" AfterTargets="Build">
    <ItemGroup>
      <TerakkiDeps Include="..\Terakki\TerakkiFramework\bin\$(Configuration)\*.dll" />
      <TerakkiDeps Include="..\Terakki\TerakkiUI\bin\$(Configuration)\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(TerakkiDeps)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" />
  </Target>
</Project>
