<UserControl x:Class="SempaPumpStation.Screens.TvView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- A rounded card in the application's colours -->
        <Style x:Key="TvCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource B.Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="16"/>
        </Style>
        <Style x:Key="TvCaption" TargetType="TextBlock" BasedOn="{StaticResource T.Label}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource B.TextDim}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="TvValue" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        </Style>

        <!-- Large tile: Q, Hm, power, efficiency (2 × 2; 3 × 2 with both efficiency bases, a smaller value) -->
        <DataTemplate x:Key="MainTile">
            <Border Style="{StaticResource TvCard}" Margin="0,0,20,20" Padding="36,20">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Caption}" Style="{StaticResource TvCaption}" FontSize="34"/>
                    <!-- A value too wide for its tile is scaled down, never up -->
                    <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="value" Text="{Binding Value}" Style="{StaticResource TvValue}" FontSize="168"/>
                            <TextBlock x:Name="unit" Text="{Binding Unit}" Style="{StaticResource TvCaption}" FontSize="52" VerticalAlignment="Bottom" Margin="18,0,0,36" TextTrimming="None"/>
                        </StackPanel>
                    </Viewbox>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="run">
                    <Setter TargetName="value" Property="Foreground" Value="{StaticResource B.Run}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="accent">
                    <Setter TargetName="value" Property="Foreground" Value="{StaticResource B.Accent}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.TileColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="3">
                    <Setter TargetName="value" Property="FontSize" Value="120"/>
                    <Setter TargetName="unit" Property="FontSize" Value="40"/>
                    <Setter TargetName="unit" Property="Margin" Value="14,0,0,26"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A number box of the header: KAYIT NO / DENEY NO -->
        <Style x:Key="NumberBox" TargetType="Border" BasedOn="{StaticResource TvCard}">
            <Setter Property="Background" Value="{StaticResource B.Card2}"/>
            <Setter Property="Padding" Value="26,10"/>
            <Setter Property="Margin" Value="16,0,0,0"/>
            <Setter Property="MinWidth" Value="220"/>
        </Style>
    </UserControl.Resources>

    <DockPanel Background="{StaticResource B.App}">
        <!-- The page's operator controls, not part of the TV picture (hidden in a TV window) -->
        <DockPanel DockPanel.Dock="Top" Margin="20,14,20,4"
                   Visibility="{Binding IsOutput, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
            <!-- Preview: which zone -->
            <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Zones}" VerticalAlignment="Top">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource Choice}" Tag="{Binding State}" Command="{Binding Command}" Padding="14,6">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- TV outputs: each zone's picture full screen on a monitor of this PC -->
            <Border Style="{StaticResource CardTight}" Margin="0,0,16,0" DataContext="{Binding Outputs}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Ekranları tanımla" Style="{StaticResource Btn}" Command="{Binding IdentifyCommand}" Margin="0,0,8,0"/>
                            <Button Content="Ekran listesini yenile" Style="{StaticResource Btn}" Command="{Binding RefreshCommand}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="TV ÇIKIŞLARI" Style="{StaticResource T.Section}" Margin="0"/>
                            <TextBlock Style="{StaticResource T.Label}" FontSize="11" TextWrapping="Wrap"
                                       Text="Her bölgenin TV ekranı seçilen monitörde tam ekran gösterilir; seçim hatırlanır ve HMI açılınca aynı monitörlerde yeniden açılır."/>
                        </StackPanel>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Rows}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource T.Value}" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <ComboBox Style="{StaticResource Cb}" Width="230" Height="30"
                                              ItemsSource="{Binding DataContext.Monitors, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                              DisplayMemberPath="Display" SelectedValuePath="DeviceName" SelectedValue="{Binding Monitor}"/>
                                    <TextBlock Text="{Binding Status}" Style="{StaticResource T.Label}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DockPanel>

        <!-- The TV picture: laid out for 1920 x 1080 and scaled to whatever screen shows it -->
        <Viewbox Stretch="Uniform">
            <Border Width="1920" Height="1080" Padding="28">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ============ Header: zone, source, numbers, clock ============ -->
                <Border Grid.Row="0" Style="{StaticResource TvCard}" Padding="30,16" Margin="0,0,0,20">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource NumberBox}">
                                <StackPanel>
                                    <TextBlock Text="KAYIT NO" Style="{StaticResource TvCaption}" FontSize="20"/>
                                    <TextBlock Text="{Binding RecordNo}" Style="{StaticResource TvValue}" FontSize="64" Foreground="{StaticResource B.Accent}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource NumberBox}">
                                <StackPanel>
                                    <TextBlock Text="DENEY NO" Style="{StaticResource TvCaption}" FontSize="20"/>
                                    <TextBlock Text="{Binding TestNo}" Style="{StaticResource TvValue}" FontSize="64" Foreground="{StaticResource B.Accent}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- The Sempa logo -->
                            <Border CornerRadius="14" Width="132" Height="132" Margin="0,0,34,0">
                                <Border.Background>
                                    <ImageBrush ImageSource="/SempaPumpStation;component/Assets/sempa_logo.png" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <StackPanel Margin="0,0,40,0" VerticalAlignment="Center">
                                <TextBlock Text="BÖLGE" Style="{StaticResource TvCaption}" FontSize="22"/>
                                <TextBlock Text="{Binding Zone}" Style="{StaticResource TvValue}" FontSize="92" Foreground="{StaticResource B.Accent}" Margin="0,-12,0,-8"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="POMPA TESTİ  ·  GÜÇ KAYNAĞI" Style="{StaticResource TvCaption}" FontSize="22"/>
                                <TextBlock Text="{Binding SourceText}" Style="{StaticResource TvValue}" FontSize="48"/>
                                <TextBlock Text="{Binding Clock}" Style="{StaticResource TvCaption}" FontSize="22" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ============ Q, Hm, power and efficiency of the zone's efficiency basis ============ -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding MainTiles}" ItemTemplate="{StaticResource MainTile}" Margin="0,0,-20,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Rows="2" Columns="{Binding DataContext.TileColumns, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- ============ State banner ============ -->
                <Border Grid.Row="2" CornerRadius="16" Padding="30,18" BorderThickness="1.5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource B.Card}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusKind}" Value="alarm">
                                    <Setter Property="Background" Value="#4A1C1C"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource B.Alarm}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusKind}" Value="run">
                                    <Setter Property="Background" Value="#1E3A2A"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource B.Run}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusKind}" Value="test">
                                    <Setter Property="Background" Value="#1C3048"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource B.Accent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusText}" FontSize="54" HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource TvValue}">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="{StaticResource B.TextDim}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusKind}" Value="alarm">
                                        <Setter Property="Foreground" Value="#FF8A80"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusKind}" Value="run">
                                        <Setter Property="Foreground" Value="{StaticResource B.Run}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusKind}" Value="test">
                                        <Setter Property="Foreground" Value="{StaticResource B.Accent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>
            </Border>
        </Viewbox>
    </DockPanel>
</UserControl>
