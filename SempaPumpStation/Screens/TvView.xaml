<UserControl x:Class="SempaPumpStation.Screens.TvView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- White tile with black text, as on the old TV page -->
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#202020"/>
            <Setter Property="BorderThickness" Value="3"/>
        </Style>
        <Style x:Key="TileText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Verdana"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="BigText" TargetType="TextBlock" BasedOn="{StaticResource TileText}">
            <Setter Property="FontSize" Value="80"/>
        </Style>
        <Style x:Key="NumberText" TargetType="TextBlock" BasedOn="{StaticResource TileText}">
            <Setter Property="FontSize" Value="44"/>
        </Style>
    </UserControl.Resources>

    <DockPanel Background="Black">
        <!-- Zone picker: an operator control, not part of the TV picture -->
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Zones}" HorizontalAlignment="Right" Margin="0,10,16,6">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource Choice}" Tag="{Binding State}" Command="{Binding Command}" Padding="14,6">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- The TV picture: drawn at the old page size and scaled to whatever screen shows it -->
        <Viewbox Stretch="Uniform">
            <Canvas Width="1910" Height="1050" Background="Black">
                <Border Canvas.Left="5" Canvas.Top="5" Width="1900" Height="60" Style="{StaticResource Tile}">
                    <TextBlock Text="{Binding Heading}" Style="{StaticResource TileText}" FontSize="30"/>
                </Border>

                <Border Canvas.Left="5" Canvas.Top="75" Width="320" Height="90" Style="{StaticResource Tile}">
                    <TextBlock Text="KAYIT NO" Style="{StaticResource NumberText}"/>
                </Border>
                <Border Canvas.Left="5" Canvas.Top="170" Width="320" Height="90" Style="{StaticResource Tile}">
                    <TextBlock Text="{Binding RecordNo}" Style="{StaticResource NumberText}"/>
                </Border>

                <Border Canvas.Left="1585" Canvas.Top="75" Width="320" Height="90" Style="{StaticResource Tile}">
                    <TextBlock Text="DENEY NO" Style="{StaticResource NumberText}"/>
                </Border>
                <Border Canvas.Left="1585" Canvas.Top="170" Width="320" Height="90" Style="{StaticResource Tile}">
                    <TextBlock Text="{Binding TestNo}" Style="{StaticResource NumberText}"/>
                </Border>

                <Border Canvas.Left="120" Canvas.Top="280" Width="830" Height="215" Style="{StaticResource Tile}">
                    <TextBlock Text="{Binding FlowText}" Style="{StaticResource BigText}"/>
                </Border>
                <Border Canvas.Left="960" Canvas.Top="280" Width="830" Height="215" Style="{StaticResource Tile}">
                    <TextBlock Text="{Binding PowerText}" Style="{StaticResource BigText}"/>
                </Border>
                <Border Canvas.Left="120" Canvas.Top="505" Width="830" Height="215" Style="{StaticResource Tile}">
                    <TextBlock Text="{Binding HeadText}" Style="{StaticResource BigText}"/>
                </Border>
                <Border Canvas.Left="960" Canvas.Top="505" Width="830" Height="215" Style="{StaticResource Tile}">
                    <TextBlock Text="{Binding EfficiencyText}" Style="{StaticResource BigText}"/>
                </Border>

                <Border Canvas.Left="5" Canvas.Top="760" Width="1900" Height="135" Style="{StaticResource Tile}">
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource TileText}" FontSize="64"/>
                </Border>
            </Canvas>
        </Viewbox>
    </DockPanel>
</UserControl>
