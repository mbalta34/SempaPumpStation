<UserControl x:Class="SempaPumpStation.Screens.AlarmsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sec="clr-namespace:TerakkiUI.Components.User;assembly=TerakkiUI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel MaxWidth="1360" HorizontalAlignment="Left">

            <!-- Header card -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="ALARMLAR" Style="{StaticResource T.H1}"/>
                        <TextBlock Text="Aktif alarm ve uyarılar. Arıza giderildikten sonra 'Alarm Reset' ile temizleyin."
                                   Style="{StaticResource T.Label}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                            <TextBlock Text="AKTİF ALARM" Style="{StaticResource T.Label}" FontSize="10" HorizontalAlignment="Right"/>
                            <TextBlock Text="{Binding Alarms.ActiveCount}" FontSize="42" FontWeight="Bold"
                                       Foreground="{StaticResource B.Alarm}" HorizontalAlignment="Right"/>
                        </StackPanel>
                        <Button Content="Alarm Reset" Style="{StaticResource Btn.Warn}" Command="{Binding ResetCommand}" sec:Access.Requires="Alarms.Reset"
                                VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Active alarms table -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="AKTİF ALARM LİSTESİ" Style="{StaticResource T.Section}"/>

                    <!-- Header row -->
                    <Grid Margin="0,4,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Zaman" Style="{StaticResource T.Label}"/>
                        <TextBlock Grid.Column="1" Text="Önem" Style="{StaticResource T.Label}"/>
                        <TextBlock Grid.Column="2" Text="Mesaj" Style="{StaticResource T.Label}"/>
                        <TextBlock Grid.Column="3" Text="Durum" Style="{StaticResource T.Label}"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource B.Border}" Margin="0,0,0,4"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="320">
                        <ItemsControl ItemsSource="{Binding Alarms.Active}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="0,7" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding TimeText}" Foreground="{StaticResource B.TextDim}" FontSize="13"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Severity}" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{Binding Severity, Converter={StaticResource Sev}}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="{StaticResource B.Text}" FontSize="13" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Column="3" Text="{Binding State}" Foreground="{StaticResource B.TextDim}" FontSize="13"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <TextBlock Text="Arızalar bölge ekranlarındaki saha simülasyonu ile (acil stop, sürücü arızası, geri bildirim arızası) tetiklenebilir."
                       Style="{StaticResource T.Label}"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
