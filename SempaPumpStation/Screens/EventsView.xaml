<UserControl x:Class="SempaPumpStation.Screens.EventsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header card -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="OLAY KAYDI" Style="{StaticResource T.H1}"/>
                <TextBlock Text="Alarm gelme/gitme ve operatör olaylarının zaman damgalı geçmişi (en yeni en üstte)."
                           Style="{StaticResource T.Label}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- History table -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header row -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Zaman" Style="{StaticResource T.Label}"/>
                    <TextBlock Grid.Column="1" Text="Durum" Style="{StaticResource T.Label}"/>
                    <TextBlock Grid.Column="2" Text="Önem" Style="{StaticResource T.Label}"/>
                    <TextBlock Grid.Column="3" Text="Mesaj" Style="{StaticResource T.Label}"/>
                </Grid>
                <Border Grid.Row="1" Height="1" Background="{StaticResource B.Border}" Margin="0,0,0,4"/>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Alarms.History}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,7" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding TimeText}" Foreground="{StaticResource B.TextDim}" FontSize="13"/>
                                        <TextBlock Grid.Column="1" Text="{Binding State}" Foreground="{StaticResource B.Text}" FontSize="13"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Severity}" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{Binding Severity, Converter={StaticResource Sev}}"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="{StaticResource B.Text}" FontSize="13" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
