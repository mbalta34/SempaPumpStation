<UserControl x:Class="SempaPumpStation.Screens.UserLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel MaxWidth="1360" HorizontalAlignment="Left">

            <!-- Header card -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="KULLANICI KAYDI" Style="{StaticResource T.H1}"/>
                    <TextBlock Text="Giriş / çıkış, hatalı giriş ve kullanıcı yönetimi kayıtları (en yeni üstte)."
                               Style="{StaticResource T.Label}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Table -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="OTURUM GEÇMİŞİ" Style="{StaticResource T.Section}"/>

                    <!-- Header row -->
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Zaman" Style="{StaticResource T.Label}"/>
                        <TextBlock Grid.Column="1" Text="Kullanıcı" Style="{StaticResource T.Label}"/>
                        <TextBlock Grid.Column="2" Text="İşlem" Style="{StaticResource T.Label}"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource B.Border}" Margin="0,0,0,4"/>

                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,8" BorderBrush="{StaticResource B.Border}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding TimeText}" Foreground="{StaticResource B.TextDim}" FontSize="13"/>
                                        <TextBlock Grid.Column="1" Text="{Binding User}" Foreground="{StaticResource B.Accent}" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Action}" Foreground="{StaticResource B.Text}" FontSize="13"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
