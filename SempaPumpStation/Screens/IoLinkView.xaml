<UserControl x:Class="SempaPumpStation.Screens.IoLinkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sec="clr-namespace:TerakkiUI.Components.User;assembly=TerakkiUI">
    <UserControl.Resources>
        <!-- A port: number, what is connected, live value. Tag = state: instrument / selected / free / absent -->
        <Style x:Key="PortCell" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
            <Setter Property="Background" Value="{StaticResource B.Field}"/>
            <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="MinHeight" Value="64"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="8,5">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="instrument">
                                <Setter Property="BorderBrush" Value="{StaticResource B.BorderHi}"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="selected">
                                <Setter Property="BorderBrush" Value="{StaticResource B.Accent}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                                <Setter Property="Background" Value="#123A44"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="free">
                                <Setter Property="Foreground" Value="{StaticResource B.TextFaint}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="absent">
                                <Setter TargetName="bd" Property="Opacity" Value="0.3"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource B.CardHi}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="PortTemplate">
            <Button Style="{StaticResource PortCell}" Tag="{Binding State}" Command="{Binding SelectCommand}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Raw}" FontSize="9.5" Foreground="{StaticResource B.TextFaint}"/>
                        <TextBlock Text="{Binding PortText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource B.Accent}"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding Value}" FontSize="11.5" Foreground="{StaticResource B.TextDim}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!-- A module: type, description, connection, 8 ports in 4 rows as in the IO list (ports row by row) -->
        <DataTemplate x:Key="ModuleTemplate">
            <Border Style="{StaticResource Card}" Padding="10">
                <StackPanel>
                    <DockPanel Margin="3,0,3,6">
                        <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Padding="8,2">
                            <TextBlock Text="{Binding Connection}" FontSize="10.5" Foreground="{StaticResource B.TextDim}"/>
                        </Border>
                        <TextBlock>
                            <Run Text="{Binding TypeName, Mode=OneWay}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource B.Text}"/>
                            <Run Text="  "/><Run Text="{Binding Description, Mode=OneWay}" FontSize="11.5" Foreground="{StaticResource B.TextDim}"/>
                        </TextBlock>
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding Ports}" ItemTemplate="{StaticResource PortTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Line diagram ============ -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Zones}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Choice}" Tag="{Binding State}" Command="{Binding Command}" Padding="16,7">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel>
                        <TextBlock Text="IO-LINK HATTI" Style="{StaticResource T.Section}"/>
                        <TextBlock Text="{Binding ZoneNote}" Style="{StaticResource T.Label}" FontSize="11"/>
                    </StackPanel>
                </DockPanel>

                <!-- Master, centred over its hubs -->
                <ContentControl Content="{Binding Master}" ContentTemplate="{StaticResource ModuleTemplate}"
                                HorizontalAlignment="Center" Width="420" Focusable="False"/>

                <!-- Connections: a stub from the master onto a bus, a drop to each hub -->
                <Grid Height="30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                        <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Rectangle Grid.Column="2" Grid.ColumnSpan="2" Width="2" Height="15" VerticalAlignment="Top" Fill="{StaticResource B.Accent}"/>
                    <Rectangle Grid.Column="1" Grid.ColumnSpan="4" Height="2" VerticalAlignment="Center" Fill="{StaticResource B.Accent}"/>
                    <Rectangle Grid.Column="0" Grid.ColumnSpan="2" Width="2" Height="15" VerticalAlignment="Bottom" Fill="{StaticResource B.Accent}"/>
                    <Rectangle Grid.Column="2" Grid.ColumnSpan="2" Width="2" Height="15" VerticalAlignment="Bottom" Fill="{StaticResource B.Accent}"/>
                    <Rectangle Grid.Column="4" Grid.ColumnSpan="2" Width="2" Height="15" VerticalAlignment="Bottom" Fill="{StaticResource B.Accent}"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding Hubs}" ItemTemplate="{StaticResource ModuleTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="0,0,8,0"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ============ Device on the selected port ============ -->
        <DockPanel Grid.Column="2">
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="RENKLER" Style="{StaticResource T.Section}"/>
                    <TextBlock Style="{StaticResource T.Label}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"
                               Text="Çerçeveli: cihazı değiştirilebilen port · Mavi: seçili port · Soluk: boş port."/>
                    <TextBlock Style="{StaticResource T.Label}" FontSize="11" TextWrapping="Wrap"
                               Text="Sağ üstte portun ham değeri; 'açık devre' o porta bir şey bağlı olmadığını gösterir."/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="TAKILI CİHAZ" Style="{StaticResource T.Section}"/>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource T.Label}" FontSize="11.5" TextWrapping="Wrap"
                               Text="Her sensörün portu sabittir. Debimetre, basınç transmitteri veya vakummetre portuna tıklayıp o porta takılı kütüphane cihazını seçin."
                               Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>

                    <StackPanel DockPanel.Dock="Top" Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
                        <TextBlock Text="{Binding SelectedTitle}" Style="{StaticResource T.H2}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding SelectedDevice}" Foreground="{StaticResource B.Accent}" FontSize="13" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding SelectedHint}" Style="{StaticResource T.Label}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,10"/>
                    </StackPanel>

                    <Border sec:Access.Requires="Instruments.Mount" Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" IsEnabled="{Binding CanAssign}">
                            <ItemsControl ItemsSource="{Binding Devices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Choice}" Tag="{Binding State}" Command="{Binding Command}" Margin="0,0,0,6">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Foreground="{StaticResource B.TextDim}"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
