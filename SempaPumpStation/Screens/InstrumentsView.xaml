<UserControl x:Class="SempaPumpStation.Screens.InstrumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SempaPumpStation.Controls">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="1.25*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Positions ============ -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="ENSTRÜMAN POZİSYONLARI" Style="{StaticResource T.Section}"/>
                    <TextBlock Style="{StaticResource T.Label}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Pozisyona takılan cihazın kütüphane numarasını girin. Yeni cihaz kabul edilince parametreleri analog girişe yüklenir; kütüphane kaydı değiştiyse Yükle'ye basın. Bölgesi çalışırken pozisyon kilitlidir; aynı cihaz iki pozisyona takılamaz."/>
                </StackPanel>
                <DataGrid Style="{StaticResource Dg}" ItemsSource="{Binding Positions}" IsReadOnly="True" RowHeight="32">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Pozisyon" Binding="{Binding Name}" Width="130"/>
                        <DataGridTextColumn Header="Tür" Binding="{Binding CategoryName}" Width="110"/>
                        <DataGridTemplateColumn Header="Cihaz No" Width="74">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <c:TagTextBox Style="{StaticResource Tb}" PlcTag="{Binding PhDeviceTag}" WriteTag="{Binding DeviceTag}" Format="0"
                                                  IsEnabled="{Binding Enabled}" Height="26" Padding="6,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Cihaz" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Device}" VerticalAlignment="Center"/>
                                        <TextBlock Text="  reddedildi" Foreground="{StaticResource B.Warn}" VerticalAlignment="Center"
                                                   Visibility="{Binding Rejected, Converter={StaticResource BoolVis}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Ölçek" Binding="{Binding Range}" Width="110"/>
                        <DataGridTextColumn Header="Değer" Binding="{Binding Pv}" Width="90"/>
                        <DataGridTemplateColumn Header="" Width="62">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Yükle" Style="{StaticResource Btn}" Padding="8,2" FontSize="11.5"
                                            Command="{Binding LoadCommand}" IsEnabled="{Binding Enabled}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- ============ Library ============ -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Choice}" Tag="{Binding State}" Command="{Binding Command}" Padding="14,7">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding LibraryTitle}" Style="{StaticResource T.Section}" Margin="0,4,0,4"/>
                    <TextBlock Style="{StaticResource T.Label}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Hücreye çift tıklayıp düzenleyin. Ham değer aralığı S7 analog kartı için tipik olarak 0…27648. Filtre: 0 yok, 1 EMA, 2 EMA + aykırı değer."/>
                </StackPanel>
                <DataGrid Style="{StaticResource Dg}" ItemsSource="{Binding Library}" FrozenColumnCount="2">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="No" Binding="{Binding Device}" IsReadOnly="True" Width="40"/>
                        <DataGridTextColumn Header="Tanım" Binding="{Binding Description}" Width="180"/>
                        <DataGridTextColumn Header="Seri No" Binding="{Binding SerialNumber}" Width="100"/>
                        <DataGridTextColumn Header="Birim" Binding="{Binding Unit}" Width="56"/>
                        <DataGridTextColumn Header="Min Ham" Binding="{Binding MinRaw}" Width="64"/>
                        <DataGridTextColumn Header="Max Ham" Binding="{Binding MaxRaw}" Width="64"/>
                        <DataGridTextColumn Header="Min" Binding="{Binding MinPv}" Width="60"/>
                        <DataGridTextColumn Header="Max" Binding="{Binding MaxPv}" Width="60"/>
                        <DataGridTextColumn Header="Filtre" Binding="{Binding FilterType}" Width="48"/>
                        <DataGridTextColumn Header="EMA α" Binding="{Binding FilterEmaAlpha}" Width="56"/>
                        <DataGridTextColumn Header="Maks. sıçrama" Binding="{Binding FilterOutlierMaxJump}" Width="80"/>
                        <DataGridTextColumn Header="Red adedi" Binding="{Binding FilterOutlierMaxRejectCount}" Width="64"/>
                        <DataGridTextColumn Header="Takılı" Binding="{Binding MountedAt}" IsReadOnly="True" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
