<UserControl x:Class="SempaPumpStation.Screens.InstrumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SempaPumpStation.Controls"
             xmlns:inf="clr-namespace:SempaPumpStation.Infrastructure"
             xmlns:sec="clr-namespace:TerakkiUI.Components.User;assembly=TerakkiUI">
    <UserControl.Resources>
        <!-- Larger headers for the full-width tables (the Dg style's own headers are 11 px) -->
        <Style x:Key="WideHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource B.Card2}"/>
            <Setter Property="Foreground" Value="{StaticResource B.TextDim}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{StaticResource B.Border}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- ============ Tabs ============ -->
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Tabs}" Margin="20,20,20,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource Choice}" Tag="{Binding State}" Command="{Binding Command}" Padding="18,8">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"/>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Margin="20,12,20,20">
            <!-- ============ Positions ============ -->
            <Border Style="{StaticResource Card}" Visibility="{Binding ShowPositions, Converter={StaticResource BoolVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="ENSTRÜMAN POZİSYONLARI" Style="{StaticResource T.Section}"/>
                        <TextBlock Style="{StaticResource T.Label}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="Pozisyona takılan cihazın kütüphane numarasını girin; cihazın kütüphane kaydı (ölçek, filtre, ortalama, katsayı ve ofset) analog girişe hemen geçer, kayıt değişince de. Bu değerler burada yalnızca gösterilir; Enstrüman Kütüphanesi'nde değiştirilir. Cihaz pompa çalışırken de değiştirilebilir; aynı cihaz iki pozisyona takılamaz. Sinyal türü PLC programında verilir (varsayılan 4…20 mA); ham değerler sayım ve mA / V olarak gösterilir."/>
                    </StackPanel>
                    <!-- Read-only except the device number (its own cell and permission): scaling, filter, coefficient, offset and average come from the library -->
                    <DataGrid x:Name="PositionsGrid" Style="{StaticResource Dg}" ItemsSource="{Binding Positions}" RowHeight="36" FontSize="14"
                              ColumnHeaderStyle="{StaticResource WideHeader}" FrozenColumnCount="1"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Pozisyon" Binding="{Binding Name}" IsReadOnly="True" Width="190"/>
                            <DataGridTextColumn Header="Tür" Binding="{Binding CategoryName}" IsReadOnly="True" Width="170"/>
                            <DataGridTemplateColumn Header="Cihaz No" Width="96" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <c:TagTextBox Style="{StaticResource Tb}" PlcTag="{Binding PhDeviceTag}" WriteTag="{Binding DeviceTag}" Format="0"
                                                      IsEnabled="{Binding Enabled}" Height="30" Padding="6,0" FontSize="14"
                                                      sec:Access.Requires="Instruments.Mount"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Cihaz" Width="240" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Device}" VerticalAlignment="Center"/>
                                            <TextBlock Text="  reddedildi" Foreground="{StaticResource B.Warn}" VerticalAlignment="Center"
                                                       Visibility="{Binding Rejected, Converter={StaticResource BoolVis}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Ölçek" Binding="{Binding Range}" IsReadOnly="True" Width="160"/>
                            <DataGridTextColumn Header="Sinyal" Binding="{Binding Channel.Signal}" IsReadOnly="True" Width="96"/>
                            <DataGridTextColumn Header="Ham" Binding="{Binding Channel.Raw}" IsReadOnly="True" Width="76"/>
                            <DataGridTextColumn Header="Filtreli ham" Binding="{Binding Channel.Filtered}" IsReadOnly="True" Width="104"/>
                            <DataGridTextColumn Header="Ham sinyal" Binding="{Binding Channel.RawSignal}" IsReadOnly="True" Width="110"/>
                            <DataGridTextColumn Header="Filtreli sinyal" Binding="{Binding Channel.FilteredSignal}" IsReadOnly="True" Width="122"/>
                            <DataGridTextColumn Header="Katsayı" Binding="{Binding Channel.Coefficient, StringFormat=0.0000}" IsReadOnly="True" Width="96"/>
                            <DataGridTextColumn Header="Ofset" Binding="{Binding Channel.Offset}" IsReadOnly="True" Width="90"/>
                            <DataGridTextColumn Header="Ortalama" Binding="{Binding Channel.FilterAverageCount}" IsReadOnly="True" Width="100"/>
                            <DataGridTextColumn Header="Değer" Binding="{Binding Pv}" IsReadOnly="True" Width="*" MinWidth="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- ============ Library ============ -->
            <Border Style="{StaticResource Card}" Visibility="{Binding ShowLibrary, Converter={StaticResource BoolVis}}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Choice}" Tag="{Binding State}" Command="{Binding Command}" Padding="16,8">
                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding LibraryTitle}" Style="{StaticResource T.Section}" Margin="0,4,0,4"/>
                        <TextBlock Style="{StaticResource T.Label}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="Hücreye tıklayıp yeni değeri yazın, Enter ile onaylayın (mühendis girişi gerekir). Ham değer aralığı S7 analog kartı için tipik olarak 0…27648. Takılı bir cihazın kaydındaki değişiklik analog girişe hemen geçer, pompa çalışırken de. Değer = ölçeklenmiş değer × katsayı + ofset (katsayı 0 ise 1 alınır). Ortalama: filtreden sonra son n değerin hareketli ortalaması (100 ms'de bir değer; 0 veya 1 = kapalı, en çok 100 = 10 s), pompanın basınç dalgalanması gibi sürekli salınımlar için."/>
                    </StackPanel>
                    <!-- Fixed column widths; on a narrow screen the table scrolls sideways (No and Tanım stay) -->
                    <DataGrid Style="{StaticResource Dg}" ItemsSource="{Binding Library}" FrozenColumnCount="2" RowHeight="36" FontSize="14.5"
                              ColumnHeaderStyle="{StaticResource WideHeader}"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                              sec:Access.Requires="Instruments.Library">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="No" Binding="{Binding Device}" IsReadOnly="True" Width="56"/>
                            <DataGridTextColumn Header="Tanım" Binding="{Binding Description}" Width="260"/>
                            <DataGridTextColumn Header="Seri No" Binding="{Binding SerialNumber}" Width="140"/>
                            <DataGridTextColumn Header="Birim" Binding="{Binding Unit}" Width="80"/>
                            <DataGridTextColumn Header="Min Ham" Binding="{Binding MinRaw}" Width="96"/>
                            <DataGridTextColumn Header="Max Ham" Binding="{Binding MaxRaw}" Width="96"/>
                            <DataGridTextColumn Header="Min" Binding="{Binding MinPv}" Width="84"/>
                            <DataGridTextColumn Header="Max" Binding="{Binding MaxPv}" Width="84"/>
                            <DataGridComboBoxColumn Header="Filtre" Width="190" ItemsSource="{x:Static inf:AnalogFilter.Items}"
                                                    EditingElementStyle="{StaticResource Cb.Cell}"
                                                    SelectedValueBinding="{Binding FilterType}" SelectedValuePath="Value" DisplayMemberPath="Display"/>
                            <DataGridTextColumn Header="EMA α" Binding="{Binding FilterEmaAlpha, StringFormat=0.0000}" Width="84"/>
                            <DataGridTextColumn Header="Maks. sıçrama" Binding="{Binding FilterOutlierMaxJump}" Width="124"/>
                            <DataGridTextColumn Header="Red adedi" Binding="{Binding FilterOutlierMaxRejectCount}" Width="96"/>
                            <DataGridTextColumn Header="Ortalama" Binding="{Binding FilterAverageCount}" Width="96"/>
                            <DataGridTextColumn Header="Katsayı" Binding="{Binding Coefficient, StringFormat=0.0000}" Width="90"/>
                            <DataGridTextColumn Header="Ofset" Binding="{Binding Offset}" Width="80"/>
                            <DataGridTextColumn Header="Takılı" Binding="{Binding MountedAt}" IsReadOnly="True" Width="*" MinWidth="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
