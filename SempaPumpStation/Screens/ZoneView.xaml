<UserControl x:Class="SempaPumpStation.Screens.ZoneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SempaPumpStation.Controls"
             xmlns:g="clr-namespace:TerakkiUI.Components.Hmi.Graphics;assembly=TerakkiUI">
    <UserControl.Resources>
        <!-- Choice tile: title + subtitle -->
        <DataTemplate x:Key="ChoiceTemplate">
            <Button Style="{StaticResource Choice}" Tag="{Binding State}" Command="{Binding Command}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Foreground="{StaticResource B.TextDim}"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <!-- ============ Zone status bar ============ -->
            <Border Style="{StaticResource CardTight}" Margin="0,0,0,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <g:HmiLamp BoolTag="{Binding Ph[LampGreen]}" Caption="ÇALIŞIYOR" OnBrush="{StaticResource B.Run}" LampSize="18" Margin="0,0,14,0"/>
                        <g:HmiLamp BoolTag="{Binding Ph[LampYellow]}" Caption="HAZIR" OnBrush="{StaticResource B.Warn}" LampSize="18" Margin="0,0,14,0"/>
                        <g:HmiLamp BoolTag="{Binding Ph[LampRed]}" Caption="ARIZA" OnBrush="{StaticResource B.Alarm}" LampSize="18"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,22,0">
                            <TextBlock Text="BÖLGE" Style="{StaticResource T.Label}" FontSize="10"/>
                            <TextBlock Text="{Binding Zone}" Style="{StaticResource T.H1}" Foreground="{StaticResource B.Accent}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,22,0" VerticalAlignment="Center">
                            <TextBlock Text="GÜÇ KAYNAĞI" Style="{StaticResource T.Label}" FontSize="10"/>
                            <TextBlock Text="{Binding SourceText}" Style="{StaticResource T.H2}"/>
                        </StackPanel>
                        <Border Style="{StaticResource Pill}" Margin="0,0,10,0">
                            <TextBlock Text="{Binding PowerStateText}" FontSize="12" Foreground="{StaticResource B.Accent}"/>
                        </Border>
                        <Border Style="{StaticResource Pill}" Margin="0,0,10,0" Background="#1E3A2A"
                                Visibility="{Binding Ph[PumpRunning].TagValue, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="POMPA ÇALIŞIYOR" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource B.Run}"/>
                        </Border>
                        <Border Style="{StaticResource Pill}" Margin="0,0,10,0" Background="#4A1C1C"
                                Visibility="{Binding Ph[EStop].TagValue, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="ACİL STOP — bırakın ve Arıza Reset'e basın" FontSize="12" FontWeight="SemiBold" Foreground="#FF8A80"/>
                        </Border>
                        <Border Style="{StaticResource Pill}" Margin="0,0,10,0" Background="#4A1C1C"
                                Visibility="{Binding Ph[DeviceFault].TagValue, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="CİHAZ ARIZASI" FontSize="12" FontWeight="SemiBold" Foreground="#FF8A80"/>
                        </Border>
                        <Border Style="{StaticResource Pill}" Margin="0,0,10,0" Background="#4A1C1C"
                                Visibility="{Binding Ph[DriveFault].TagValue, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="SÜRÜCÜ ARIZASI" FontSize="12" FontWeight="SemiBold" Foreground="#FF8A80"/>
                        </Border>
                        <Border Style="{StaticResource Pill}" Background="#3A3220"
                                Visibility="{Binding Ph[SelectionRejected].TagValue, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="Seçim reddedildi" FontSize="12" Foreground="{StaticResource B.Warn}"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="0.9*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1.05*"/>
                </Grid.ColumnDefinitions>

                <!-- ============ Selection ============ -->
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="Pompa çalışırken kilitli" Style="{StaticResource T.Label}" FontSize="10.5"
                                           Visibility="{Binding Ph[PowerSource.Enabled].TagValue, Converter={StaticResource BoolVis}, ConverterParameter=invert}"/>
                                <TextBlock Text="GÜÇ KAYNAĞI" Style="{StaticResource T.Section}"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Sources}" ItemTemplate="{StaticResource ChoiceTemplate}"
                                          IsEnabled="{Binding Ph[PowerSource.Enabled].TagValue}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="DEBİMETRE" Style="{StaticResource T.Section}"/>
                            <ItemsControl ItemsSource="{Binding Flowmeters}" ItemTemplate="{StaticResource ChoiceTemplate}"
                                          IsEnabled="{Binding Ph[Flowmeter.Enabled].TagValue}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Text="BASMA BASINÇ TRANSMİTTERİ" Style="{StaticResource T.Section}" Margin="0,8,0,8"/>
                            <ItemsControl ItemsSource="{Binding Transmitters}" ItemTemplate="{StaticResource ChoiceTemplate}"
                                          IsEnabled="{Binding Ph[DischargeTransmitter.Enabled].TagValue}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Text="{Binding InstrumentsText}" Style="{StaticResource T.Label}" Margin="0,2,0,0"/>
                            <Button Content="Enstrüman pozisyonları →" Style="{StaticResource Btn}" HorizontalAlignment="Left" Margin="0,10,0,0"
                                    Click="Instruments_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="HIZ REFERANSI" Style="{StaticResource T.Section}"/>
                            <StackPanel Orientation="Horizontal">
                                <c:TagTextBox Style="{StaticResource Tb}" PlcTag="{Binding Ph[SpeedReference.Value]}" WriteTag="{Binding Hp[SpeedReference.Value]}" Format="0.0"
                                              IsEnabled="{Binding Ph[SpeedReference.Enabled].TagValue}" Width="120"/>
                                <TextBlock Text="%" Style="{StaticResource T.Value}" Foreground="{StaticResource B.TextDim}"
                                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource T.Label}" FontSize="11" Margin="0,6,0,0"
                                       Text="{Binding IsVfd, Converter={StaticResource BoolText}, ConverterParameter=VFD hız referansı olarak gönderilir.|Soft starter tam hızda çalışır; referans yalnızca VFD kaynaklarında kullanılır.}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ============ Live values ============ -->
                <StackPanel Grid.Column="2">
                    <UniformGrid Columns="2">
                        <c:MetricTile Caption="DEBİ" Unit="{Binding FlowUnit}" ValueSize="26" Margin="0,0,8,8" ValueBrush="{StaticResource B.Run}"
                                      Value="{Binding Ph[Flow].TagValue, Converter={StaticResource Fmt}, ConverterParameter=0.0}"/>
                        <c:MetricTile Caption="BASMA YÜKSEKLİĞİ (Hm)" Unit="m" ValueSize="26" Margin="0,0,0,8" ValueBrush="{StaticResource B.Accent}"
                                      Value="{Binding Head, Converter={StaticResource Fmt}, ConverterParameter=0.0}"/>
                        <c:MetricTile Caption="BASMA BASINCI" Unit="bar" ValueSize="22" Margin="0,0,8,8"
                                      Value="{Binding Ph[DischargePressure].TagValue, Converter={StaticResource Fmt}, ConverterParameter=0.00}"/>
                        <c:MetricTile Caption="EMME BASINCI" Unit="bar" ValueSize="22" Margin="0,0,0,8"
                                      Value="{Binding Ph[SuctionPressure].TagValue, Converter={StaticResource Fmt}, ConverterParameter=0.000}"/>
                        <c:MetricTile Caption="DEVİR" Unit="d/dk" ValueSize="22" Margin="0,0,8,8"
                                      Value="{Binding Ai[Speed.Pv].TagValue, Converter={StaticResource Fmt}, ConverterParameter=0}"/>
                        <c:MetricTile Caption="SU SICAKLIĞI" Unit="°C" ValueSize="22" Margin="0,0,0,8"
                                      Value="{Binding Ai[WaterTemperature.Pv].TagValue, Converter={StaticResource Fmt}, ConverterParameter=0.0}"/>
                        <c:MetricTile Caption="MOTOR SICAKLIĞI" Unit="°C" ValueSize="22" Margin="0,0,8,8"
                                      Value="{Binding Ai[Temperature.Pv].TagValue, Converter={StaticResource Fmt}, ConverterParameter=0.0}"/>
                        <c:MetricTile Caption="TİTREŞİM" Unit="mm/s" ValueSize="22" Margin="0,0,0,8"
                                      Value="{Binding Ai[Vibration.Pv].TagValue, Converter={StaticResource Fmt}, ConverterParameter=0.00}"/>
                        <c:MetricTile Caption="SES" Unit="dB" ValueSize="22" Margin="0,0,8,8"
                                      Value="{Binding Ai[Sound.Pv].TagValue, Converter={StaticResource Fmt}, ConverterParameter=0.0}"/>
                        <c:MetricTile Caption="ORTAM SICAKLIĞI" Unit="°C" ValueSize="22" Margin="0,0,0,8"
                                      Value="{Binding Ai[AmbientTemperature.Pv].TagValue, Converter={StaticResource Fmt}, ConverterParameter=0.0}"/>
                    </UniformGrid>
                    <TextBlock Style="{StaticResource T.Label}" FontSize="11" TextWrapping="Wrap" Margin="2,4,0,0"
                               Text="Gerilim ve akım Modbus güç analizöründen gelecek; PLC'de henüz bağlı değil."/>
                </StackPanel>

                <!-- ============ Test & samples ============ -->
                <StackPanel Grid.Column="4">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource Pill}" Background="#1E3A2A"
                                        Visibility="{Binding Ph[TestActive].TagValue, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="TEST AKTİF" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource B.Run}"/>
                                </Border>
                                <TextBlock Text="TEST" Style="{StaticResource T.Section}"/>
                            </DockPanel>
                            <TextBlock Text="{Binding TestText}" Style="{StaticResource T.Label}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <UniformGrid Columns="2">
                                <Button Content="▶  Testi Başlat" Style="{StaticResource Btn.Success}" Margin="0,0,8,8"
                                        Command="{Binding ClickCommand}" CommandParameter="StartTest"
                                        IsEnabled="{Binding Ph[StartTest.Enabled].TagValue}"/>
                                <Button Content="■  Testi Bitir" Style="{StaticResource Btn.Primary}" Margin="0,0,0,8"
                                        Command="{Binding ClickCommand}" CommandParameter="EndTest"
                                        IsEnabled="{Binding Ph[EndTest.Enabled].TagValue}"/>
                                <Button Content="Pompayı Durdur" Style="{StaticResource Btn.Danger}" Margin="0,0,8,0"
                                        Command="{Binding ClickCommand}" CommandParameter="Stop"
                                        IsEnabled="{Binding Ph[Stop.Enabled].TagValue}"/>
                                <Button Content="Arıza Reset" Style="{StaticResource Btn.Warn}"
                                        Command="{Binding ClickCommand}" CommandParameter="ResetFault"
                                        IsEnabled="{Binding Ph[ResetFault.Enabled].TagValue}"/>
                            </UniformGrid>
                            <TextBlock Style="{StaticResource T.Label}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="Pompa sahadaki START butonu ile çalışır (test şart değil). Numune yalnızca test aktifken alınır; test bitince numuneler arşive yazılır."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="Son Numuneyi Sil" Style="{StaticResource Btn}" Padding="10,5" FontSize="12" Margin="0,0,6,0"
                                            Command="{Binding ClickCommand}" CommandParameter="DeleteLastSample"/>
                                    <Button Content="Temizle" Style="{StaticResource Btn}" Padding="10,5" FontSize="12"
                                            Command="{Binding ClickCommand}" CommandParameter="ClearSamples"/>
                                </StackPanel>
                                <TextBlock VerticalAlignment="Center">
                                    <Run Text="NUMUNELER  " FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource B.Accent}"/>
                                    <Run Text="{Binding Ph[SampleCount].TagValue, Mode=OneWay}" FontSize="15" FontWeight="SemiBold"/>
                                    <Run Text=" / 50" Foreground="{StaticResource B.TextDim}"/>
                                </TextBlock>
                            </DockPanel>
                            <DataGrid Style="{StaticResource Dg}" ItemsSource="{Binding SampleRows}" IsReadOnly="True" Height="300">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="No" Binding="{Binding No}" Width="40"/>
                                    <DataGridTextColumn Header="Saat" Binding="{Binding TimeText}" Width="70"/>
                                    <DataGridTextColumn Header="Q" Binding="{Binding Flow, StringFormat=0.0}" Width="*"/>
                                    <DataGridTextColumn Header="Pd bar" Binding="{Binding DischargePressure, StringFormat=0.00}" Width="*"/>
                                    <DataGridTextColumn Header="Ps bar" Binding="{Binding SuctionPressure, StringFormat=0.000}" Width="*"/>
                                    <DataGridTextColumn Header="Hm m" Binding="{Binding Head, StringFormat=0.0}" Width="*"/>
                                    <DataGridTextColumn Header="d/dk" Binding="{Binding Speed, StringFormat=0}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ============ Simulated field ============ -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" BorderBrush="#4A3A1A" BorderThickness="1"
                    Visibility="{Binding Context.IsSimulation, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <TextBlock Text="SAHA SİMÜLASYONU — gerçek sistemde bu sinyaller sahadan gelir" Style="{StaticResource T.Section}"
                               Foreground="{StaticResource B.Warn}"/>
                    <WrapPanel>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="PANDANT" Style="{StaticResource T.Label}" FontSize="10" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="START" Style="{StaticResource Btn.Success}" Margin="0,0,6,0" Command="{Binding PendantCommand}" CommandParameter="PendantStart"/>
                                <Button Content="STOP" Style="{StaticResource Btn.Danger}" Margin="0,0,6,0" Command="{Binding PendantCommand}" CommandParameter="PendantStop"/>
                                <Button Content="NUMUNE AL" Style="{StaticResource Btn.Primary}" Command="{Binding PendantCommand}" CommandParameter="PendantTakeSample"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="ACİL STOP BUTONU" Style="{StaticResource T.Label}" FontSize="10" Margin="0,0,0,4"/>
                            <Button Style="{StaticResource Btn.Danger}" Command="{Binding ToggleEStopCommand}"
                                    Content="{Binding Sim[EStopPressed].TagValue, Converter={StaticResource BoolText}, ConverterParameter=Basılı — bırak|Bas}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,24,0" Width="260">
                            <TextBlock Style="{StaticResource T.Label}" FontSize="10" Margin="0,0,0,4">
                                <Run Text="BASMA VANASI  "/><Run Text="{Binding ValveOpening, Mode=OneWay, StringFormat=0}"/><Run Text=" %"/>
                            </TextBlock>
                            <Slider Minimum="0" Maximum="100" Value="{Binding ValveOpening}" SmallChange="1" LargeChange="10" Margin="0,6,0,0"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="ARIZA ENJEKSİYONU" Style="{StaticResource T.Label}" FontSize="10" Margin="0,0,0,4"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource Btn.Warn}" Margin="0,0,6,0" Command="{Binding ToggleDriveFaultCommand}"
                                        Content="{Binding DriveFaultInjected, Converter={StaticResource BoolText}, ConverterParameter=Sürücü arızasını kaldır|Seçili sürücüye arıza}"/>
                                <Button Style="{StaticResource Btn.Warn}" Command="{Binding ToggleFeedbackFaultCommand}"
                                        Content="{Binding Sim[FeedbackFault].TagValue, Converter={StaticResource BoolText}, ConverterParameter=Geri bildirimi düzelt|Geri bildirim beslemesini kes}"/>
                            </StackPanel>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
