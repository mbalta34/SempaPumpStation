<UserControl x:Class="SempaPumpStation.Screens.TrendView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:g="clr-namespace:TerakkiUI.Components.Hmi.Graphics;assembly=TerakkiUI">
    <Grid Margin="20">
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Zones}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Choice}" Tag="{Binding State}" Command="{Binding Command}" Padding="14,6">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="CANLI TREND — SON 120 SANİYE" Style="{StaticResource T.Section}" VerticalAlignment="Center"/>
                </DockPanel>

                <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <Border Width="14" Height="14" CornerRadius="3" Background="#3B82F6" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Debi" Style="{StaticResource T.Label}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <Border Width="14" Height="14" CornerRadius="3" Background="#2ECC71" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Basma basıncı (bar)" Style="{StaticResource T.Label}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                        <Border Width="14" Height="14" CornerRadius="3" Background="#F5A623" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Emme basıncı (bar)" Style="{StaticResource T.Label}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="14" Height="14" CornerRadius="3" Background="#22C1D6" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Titreşim (mm/s)" Style="{StaticResource T.Label}"/>
                    </StackPanel>
                </WrapPanel>

                <g:HmiTrend x:Name="Trend" Grid.Row="2" TimeWindowSeconds="120" GridDivisions="4"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
