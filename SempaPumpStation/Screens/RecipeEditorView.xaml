<UserControl x:Class="SempaPumpStation.Screens.RecipeEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SempaPumpStation.Controls">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Recipe list -->
        <Border Grid.Column="0" Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="REÇETELER" Style="{StaticResource T.Section}"/>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <TextBlock Text="Reçete Adı" Style="{StaticResource T.Label}" FontSize="10.5" Margin="0,0,0,3"/>
                    <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                    <UniformGrid Columns="2">
                        <Button Content="Yeni" Style="{StaticResource Btn}" Command="{Binding NewCommand}" Margin="0,0,5,0"/>
                        <Button Content="Kaydet" Style="{StaticResource Btn.Primary}" Command="{Binding SaveCommand}" Margin="5,0,0,0"/>
                    </UniformGrid>
                    <UniformGrid Columns="2" Margin="0,8,0,0">
                        <Button Content="Yükle" Style="{StaticResource Btn}" Command="{Binding LoadCommand}" Margin="0,0,5,0"/>
                        <Button Content="Sil" Style="{StaticResource Btn.Danger}" Command="{Binding DeleteCommand}" Margin="5,0,0,0"/>
                    </UniformGrid>
                </StackPanel>
                <ListBox Style="{StaticResource Lb}" ItemContainerStyle="{StaticResource LbItem}" Margin="0,4,0,0"
                         ItemsSource="{Binding Recipes}" SelectedItem="{Binding SelectedRecipe, Mode=TwoWay}"/>
            </DockPanel>
        </Border>

        <!-- Fields -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel>
                <Grid DockPanel.Dock="Top">
                    <TextBlock Text="{Binding Title}" Style="{StaticResource T.H2}" VerticalAlignment="Center"/>
                    <Button Content="Rapora Uygula (Seç) →" Style="{StaticResource Btn.Success}"
                            HorizontalAlignment="Right" Command="{Binding SelectForReportCommand}"/>
                </Grid>
                <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource B.Border}" Margin="0,12"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Fields}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <c:LabeledField Label="{Binding Label}" FieldTag="{Binding Tag}" Format="{Binding Format}" Margin="0,0,14,0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
