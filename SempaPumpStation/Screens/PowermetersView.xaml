<UserControl x:Class="SempaPumpStation.Screens.PowermetersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Shared column layout of the header and the value rows -->
        <Style x:Key="Cell" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource B.Text}"/>
        </Style>
        <Style x:Key="HeadCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource B.TextFaint}"/>
        </Style>

        <DataTemplate x:Key="RowTemplate">
            <Grid Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" Style="{StaticResource Cell}" HorizontalAlignment="Left" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="{Binding Voltage}" Style="{StaticResource Cell}"/>
                <TextBlock Grid.Column="2" Text="{Binding Current}" Style="{StaticResource Cell}"/>
                <TextBlock Grid.Column="3" Text="{Binding ActivePower}" Style="{StaticResource Cell}"/>
                <TextBlock Grid.Column="4" Text="{Binding ReactivePower}" Style="{StaticResource Cell}"/>
                <TextBlock Grid.Column="5" Text="{Binding ApparentPower}" Style="{StaticResource Cell}"/>
                <TextBlock Grid.Column="6" Text="{Binding PowerFactor}" Style="{StaticResource Cell}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MeterTemplate">
            <Border Style="{StaticResource Card}" Margin="0,0,14,14" Padding="14,12">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" x:Name="status" Style="{StaticResource Pill}" Background="#4A1C1C" Padding="9,2">
                            <TextBlock x:Name="statusText" Text="İLETİŞİM YOK" FontSize="10.5" FontWeight="SemiBold" Foreground="#FF8A80"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource T.Section}" Margin="0"/>
                            <TextBlock Text="{Binding Usage}" Style="{StaticResource T.Label}" FontSize="11"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Header -->
                    <Grid Margin="0,10,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="V" Style="{StaticResource HeadCell}"/>
                        <TextBlock Grid.Column="2" Text="A" Style="{StaticResource HeadCell}"/>
                        <TextBlock Grid.Column="3" Text="kW" Style="{StaticResource HeadCell}"/>
                        <TextBlock Grid.Column="4" Text="kVAR" Style="{StaticResource HeadCell}"/>
                        <TextBlock Grid.Column="5" Text="kVA" Style="{StaticResource HeadCell}"/>
                        <TextBlock Grid.Column="6" Text="cos φ" Style="{StaticResource HeadCell}"/>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource RowTemplate}"/>

                    <UniformGrid Columns="3" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="AKTİF GÜÇ" Style="{StaticResource T.Label}" FontSize="10.5"/>
                            <TextBlock Style="{StaticResource T.Base}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource B.Run}">
                                <Run Text="{Binding ActivePower, Mode=OneWay}"/><Run Text=" kW" FontSize="12" Foreground="{StaticResource B.TextDim}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="FREKANS" Style="{StaticResource T.Label}" FontSize="10.5"/>
                            <TextBlock Style="{StaticResource T.Base}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource B.Text}">
                                <Run Text="{Binding Frequency, Mode=OneWay}"/><Run Text=" Hz" FontSize="12" Foreground="{StaticResource B.TextDim}"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="AKTİF ENERJİ" Style="{StaticResource T.Label}" FontSize="10.5"/>
                            <TextBlock Style="{StaticResource T.Base}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource B.Text}">
                                <Run Text="{Binding Energy, Mode=OneWay}"/><Run Text=" kWh" FontSize="12" Foreground="{StaticResource B.TextDim}"/>
                            </TextBlock>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding CommOk}" Value="True">
                    <Setter TargetName="status" Property="Background" Value="#1C3A2A"/>
                    <Setter TargetName="statusText" Property="Text" Value="BAĞLI"/>
                    <Setter TargetName="statusText" Property="Foreground" Value="{StaticResource B.Run}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,20,6,6">
        <StackPanel>
            <TextBlock Style="{StaticResource T.Label}" TextWrapping="Wrap" Margin="0,0,14,12"
                       Text="Her güç kaynağında bir Schneider PM5550 enerji analizörü; PLC değerleri Modbus TCP ile okur. Fazlarda faz-nötr gerilim, toplamda faz-faz ortalama gerilim ve ortalama akım gösterilir. IP adresleri ve iletişim izni PLC'de DB_Communication_ModbusDevices'ta ayarlanır."/>
            <ItemsControl ItemsSource="{Binding Meters}" ItemTemplate="{StaticResource MeterTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
