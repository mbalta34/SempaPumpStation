<UserControl x:Class="SempaPumpStation.Screens.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:SempaPumpStation.Controls"
             xmlns:g="clr-namespace:TerakkiUI.Components.Hmi.Graphics;assembly=TerakkiUI">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <!-- ============ Zones ============ -->
            <ItemsControl ItemsSource="{Binding Zones}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,14,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <g:HmiLamp BoolTag="{Binding Ph[LampGreen]}" OnBrush="{StaticResource B.Run}" LampSize="16" Margin="0,0,6,0"/>
                                        <g:HmiLamp BoolTag="{Binding Ph[LampYellow]}" OnBrush="{StaticResource B.Warn}" LampSize="16" Margin="0,0,6,0"/>
                                        <g:HmiLamp BoolTag="{Binding Ph[LampRed]}" OnBrush="{StaticResource B.Alarm}" LampSize="16"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource T.H2}" Foreground="{StaticResource B.Accent}"/>
                                        <TextBlock Text="{Binding Source}" Style="{StaticResource T.Value}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </DockPanel>

                                <Border Style="{StaticResource Pill}" HorizontalAlignment="Left" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding State}" FontSize="12" FontWeight="SemiBold"/>
                                </Border>

                                <UniformGrid Columns="2">
                                    <c:MetricTile Caption="DEBİ" Unit="m³/h" ValueSize="22" Margin="0,0,6,6" ValueBrush="{StaticResource B.Run}"
                                                  Value="{Binding Ph[Flow].TagValue, Converter={StaticResource Fmt}, ConverterParameter=0.0}"/>
                                    <c:MetricTile Caption="BASMA" Unit="bar" ValueSize="22" Margin="0,0,0,6"
                                                  Value="{Binding Ph[DischargePressure].TagValue, Converter={StaticResource Fmt}, ConverterParameter=0.00}"/>
                                    <c:MetricTile Caption="EMME" Unit="bar" ValueSize="22" Margin="0,0,6,0"
                                                  Value="{Binding Ph[SuctionPressure].TagValue, Converter={StaticResource Fmt}, ConverterParameter=0.000}"/>
                                    <c:MetricTile Caption="DEVİR" Unit="d/dk" ValueSize="22"
                                                  Value="{Binding Ai[Speed.Pv].TagValue, Converter={StaticResource Fmt}, ConverterParameter=0}"/>
                                </UniformGrid>

                                <DockPanel Margin="0,12,0,0">
                                    <Button DockPanel.Dock="Right" Content="Bölgeyi Aç →" Style="{StaticResource Btn.Primary}" Command="{Binding OpenCommand}"/>
                                    <TextBlock Text="{Binding Test}" Style="{StaticResource T.Label}" VerticalAlignment="Center"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ============ Central cabinet ============ -->
            <Border Style="{StaticResource Card}" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="MERKEZİ PANO — GÜÇ KAYNAKLARI" Style="{StaticResource T.Section}"/>
                    <ItemsControl ItemsSource="{Binding Sources}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Columns="4"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource B.Field}" BorderBrush="{StaticResource B.Border}" BorderThickness="1"
                                        CornerRadius="6" Padding="12,9" Margin="0,0,10,10">
                                    <DockPanel>
                                        <Ellipse DockPanel.Dock="Right" Width="12" Height="12" VerticalAlignment="Top"
                                                 Fill="{StaticResource B.Run}"
                                                 Visibility="{Binding Running, Converter={StaticResource BoolVis}}"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock FontSize="11" Foreground="{StaticResource B.TextDim}" Margin="0,3,0,0">
                                                <Run Text="Seçen: "/><Run Text="{Binding Owner, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding State, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
